# ============================================================================
# TURNCOAT — Environment Variables
# Copy to .env.local. NEVER commit .env.local.
# NEVER put a secret in a NEXT_PUBLIC_* variable (bundled into client JS).
# ============================================================================

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---
# Placeholder values pass validation, so `npm run dev` works before you
# create a project. Replace with real values to use auth/database.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS. Used only in trusted server contexts (Phase 10).
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (docs/ai.md). "mock" needs no credentials. ---
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

# --- News provider (docs/current-affairs.md) ---
NEWS_PROVIDER=mock
